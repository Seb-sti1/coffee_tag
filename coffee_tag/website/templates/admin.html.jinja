<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO"
        crossorigin="anonymous"></script>
<script>
    // --- Restore active tab from URL hash on page load ---
    document.addEventListener("DOMContentLoaded", () => {
        const hash = window.location.hash;
        if (hash) {
            const tab = document.querySelector(`.nav-link[href="${hash}"]`);
            if (tab) bootstrap.Tab.getOrCreateInstance(tab).show();
        }

        // Update hash when switching tabs
        document.querySelectorAll('.nav-link[data-bs-toggle="tab"]').forEach(tab => {
            tab.addEventListener("shown.bs.tab", e => {
                history.replaceState(null, null, e.target.getAttribute("href"));
            });
        });
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Column toggle for purchase table
        const purchaseHeaders = document.querySelectorAll('#purchaseList thead th');
        const purchaseMenu = document.getElementById('purchaseColMenu');
        purchaseHeaders.forEach((th, i) => {
            const li = document.createElement('li');
            const label = document.createElement('label');
            label.className = 'dropdown-item d-flex align-items-center gap-2';
            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.checked = true;
            cb.addEventListener('change', () => {
                const show = cb.checked;
                document.querySelectorAll(`#purchaseList tr`).forEach(row => {
                    if (row.children[i]) row.children[i].style.display = show ? '' : 'none';
                });
            });
            label.appendChild(cb);
            label.appendChild(document.createTextNode(' ' + th.textContent.trim()));
            li.appendChild(label);
            purchaseMenu.appendChild(li);
        });
    });
</script>
<script>
    let daily_counts = {{ daily_counts | tojson }};
    daily_counts = daily_counts.filter(r => r[2] > 0);
    const labels = daily_counts.map(r => {
        const [datePart] = r[0].split(' ');
        const d = new Date(datePart);
        return d.getDate() + '/' + (d.getMonth() + 1);
    });

    const pct = (v, t) => t === 0 ? 0 : parseFloat((v / t * 100).toFixed(2));
    const stolen = r => Math.max(0, r[2] - r[3] - r[4]);
    const miscount = r => Math.max(0, r[3] + r[4] - r[2]);

    const purchasedPct = daily_counts.map(r => pct(r[3] - miscount(r), r[2]));
    const lostPct = daily_counts.map(r => pct(r[4], r[2]));
    const stolenPct = daily_counts.map(r => pct(stolen(r), r[2]));
    const miscountPct = daily_counts.map(r => pct(miscount(r), r[2]));

    const purchasedRaw = daily_counts.map(r => r[3] - miscount(r));
    const lostRaw = daily_counts.map(r => r[4]);
    const stolenRaw = daily_counts.map(r => stolen(r));
    const miscountRaw = daily_counts.map(r => miscount(r));

    document.getElementById('m-brewed').textContent = daily_counts.reduce((a, r) => a + r[2], 0);
    document.getElementById('m-purchased').textContent = daily_counts.reduce((a, r) => a + r[3], 0);
    document.getElementById('m-lost').textContent = daily_counts.reduce((a, r) => a + r[4], 0);
    document.getElementById('m-stolen').textContent = daily_counts.reduce((a, r) => a + stolen(r), 0);
    document.getElementById('m-miscount').textContent = daily_counts.reduce((a, r) => a + miscount(r), 0);

    const findRow = label => daily_counts.find(r => {
        const [datePart] = r[0].split(' ');
        const d = new Date(datePart);
        return d.getDate() + '/' + (d.getMonth() + 1) === label;
    });

    const tooltipTitle = items => {
        const r = findRow(items[0].label);
        if (!r) return items[0].label;
        return r[0] + '  →  ' + r[1] + '  (' + r[2] + ' brewed)';
    };

    const tooltipLabel = (ctx, isPct) => {
        const r = findRow(ctx.label);
        if (!r) return ctx.dataset.label;
        const val = ctx.dataset.label === 'Purchased' ? r[3]
            : ctx.dataset.label === 'Lost' ? r[4]
                : ctx.dataset.label === 'Stolen' ? stolen(r)
                    : miscount(r);
        return isPct
            ? ' ' + ctx.dataset.label + ': ' + val + '  (' + Math.abs(ctx.parsed.y).toFixed(1) + '%)'
            : ' ' + ctx.dataset.label + ': ' + val;
    };

    const makeDatasets = (pArr, lArr, sArr, mArr) => [
        {label: 'Purchased', data: pArr, backgroundColor: '#008000', stack: 's', borderRadius: 0, borderSkipped: false},
        {label: 'Lost', data: lArr, backgroundColor: '#ffa500', stack: 's', borderRadius: 0, borderSkipped: false},
        {label: 'Stolen', data: sArr, backgroundColor: '#FF0000', stack: 's', borderRadius: 0, borderSkipped: false},
        {label: 'Miscount', data: mArr, backgroundColor: '#9b59b6', stack: 's', borderRadius: 0, borderSkipped: false},
    ];

    const commonOptions = (title, isPct) => ({
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {display: true},
            title: {display: true, text: title},
            tooltip: {
                callbacks: {
                    title: tooltipTitle,
                    label: ctx => tooltipLabel(ctx, isPct)
                }
            }
        },
        scales: {
            x: {
                stacked: true,
                ticks: {autoSkip: true, maxRotation: 45, font: {size: 10}},
                grid: {display: false}
            },
            y: {
                stacked: true,
                ...(isPct ? {ticks: {callback: v => v + '%', stepSize: 25}} : {})
            }
        }
    });

    new Chart(document.getElementById('pctChart'), {
        type: 'bar',
        data: {labels, datasets: makeDatasets(purchasedPct, lostPct, stolenPct, miscountPct)},
        options: commonOptions('Share of brewed', true)
    });

    new Chart(document.getElementById('rawChart'), {
        type: 'bar',
        data: {labels, datasets: makeDatasets(purchasedRaw, lostRaw, stolenRaw, miscountRaw)},
        options: commonOptions('Raw counts', false)
    });
</script>
</body>
</html>
