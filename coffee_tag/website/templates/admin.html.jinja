<!doctype html>
<html xmlns="http://www.w3.org/1999/html">
<head>
    <title>The U2IS Coffee Machine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="{{ url_for('static', filename='admin.css') }}" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
<header class="navbar sticky-top bg-dark flex-md-nowrap p-0 shadow" data-bs-theme="dark">
    <p class="navbar-brand col-md-3 col-lg-2 m-0 me-0 px-3 fs-6 text-white">☕ The U2IS Coffee Machine ☕</p>
</header>
<div class="container-fluid">
    <div class="row" style="height: calc(100vh - 48px);">
        <div class="sidebar border border-right col-md-3 col-lg-2 p-0 bg-body-tertiary">
            <div class="offcanvas-md offcanvas-end bg-body-tertiary" tabindex="-1" id="sidebarMenu"
                 aria-labelledby="sidebarMenuLabel">
                <div class="offcanvas-body d-md-flex flex-column p-0 pt-lg-3 overflow-y-auto">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2 active" data-bs-toggle="tab"
                               href="#dashboard">
                                <i class="bi bi-house-fill"></i>
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" data-bs-toggle="tab" href="#users">
                                <i class="bi bi-people-fill"></i>
                                Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" data-bs-toggle="tab" href="#transfers">
                                <i class="bi bi-coin"></i>
                                Transfers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" data-bs-toggle="tab" href="#emails">
                                <i class="bi bi-envelope-at"></i>
                                Emails
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" data-bs-toggle="tab" href="#purchases">
                                <i class="bi bi-cart3"></i>
                                Purchases
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" data-bs-toggle="tab" href="#stocks">
                                <i class="bi bi-box-seam"></i>
                                Stocks
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" data-bs-toggle="tab" href="#reports">
                                <i class="bi bi-graph-up"></i>
                                Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" data-bs-toggle="tab" href="#exports">
                                <i class="bi bi-download"></i>
                                Exports
                            </a>
                        </li>
                    </ul>

                    <hr class="my-3">

                    <ul class="nav flex-column mb-auto">
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" href="/logout">
                                <i class="bi bi-door-closed"></i>
                                Sign out
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 h-100 overflow-y-auto">
            <div class="tab-content">
                {# =================== DASHBOARD =================== #}
                <div class="tab-pane fade show active" id="dashboard">
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                        <h1 class="h2">Dashboard</h1>
                    </div>
                    <p>Dashboard content...</p>
                </div>

                {# =================== USERS =================== #}
                <div class="tab-pane fade" id="users">
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                        <h1 class="h2">Users</h1>
                        <div class="dropdown mb-3">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                <i class="bi bi-layout-three-columns"></i> Columns
                            </button>
                            <ul class="dropdown-menu p-2" id="colMenu"
                                style="min-width:200px; max-height:400px; overflow-y:auto;"></ul>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table id="userList" class="table table-bordered table-hover table-sm align-middle">
                            <thead class="table-dark">
                            <tr>
                                <th class="sortable" onclick="sortTable(0, true, false, 'userList')">id<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(1, false, false, 'userList')">name<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(2, false, false, 'userList')">surname<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(3, false, false, 'userList')">nickname<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(4, false, false, 'userList')">cascad username<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(5, true, false, 'userList')">initial balance<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(6, false, false, 'userList')">passcode set<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(7, false, false, 'userList')">permissions<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(8, false, false, 'userList')">status<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(9, false, true, 'userList')">creation<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(10, false, true, 'userList')">departure<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(11, false, false, 'userList')">mail<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(12, false, false, 'userList')">id badge<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(13, true, false, 'userList')">beans<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(14, true, false, 'userList')">water (ml)<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(15, true, false, 'userList')">purchased<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(16, true, false, 'userList')">paid<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(17, true, false, 'userList')">balance<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                                <th class="sortable" onclick="sortTable(18, false, true, 'userList')">last coffee<i
                                        class="bi bi-arrow-down-up text-secondary small"></i></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for user in users %}
                                <tr>
                                    {% for property in user %}
                                        {% if loop.index == 7 %}
                                            <td>
                                                {% if property != None %}
                                                    <span class="badge text-bg-success">Yes</span>
                                                {% else %}
                                                    <span class="badge text-bg-danger">No</span>
                                                {% endif %}
                                            </td>
                                        {% elif loop.index == 17 %}
                                            <td class="{% if property > 0 %}text-danger fw-semibold{% elif property < 0 %}text-success fw-semibold{% endif %}">
                                                {{ property }}
                                            </td>
                                        {% else %}
                                            <td>{{ property }}</td>
                                        {% endif %}
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# =================== TRANSFERS =================== #}
                <div class="tab-pane fade" id="transfers">
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                        <h1 class="h2">Transfers</h1>
                        <form method="get" action="" class="d-flex align-items-center gap-2" id="dateFilterForm">
                            <label class="form-label mb-0 text-nowrap" for="purchaseFrom">From</label>
                            <input type="date" id="purchaseFrom" name="from" class="form-control form-control-sm"
                                   value="{{ filter_from }}"/>
                            <label class="form-label mb-0 text-nowrap" for="purchaseTo">To</label>
                            <input type="date" id="purchaseTo" name="to" class="form-control form-control-sm"
                                   value="{{ filter_to }}"/>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-funnel"></i> Apply
                            </button>
                            <a href="?" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset
                            </a>
                        </form>
                    </div>

                    {# ERROR #}
                    {% if "add_transfer" in returned_form_values %}
                        <div class="alert {{ 'alert-success' if returned_form_values['add_transfer'] else 'alert-danger' }} alert-dismissible fade show"
                             role="alert">
                            {{ 'Transfer added successfully.' if returned_form_values['add_transfer'] else 'An error occurred while adding the Transfer.' }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endif %}
                    {% if "remove_transfer" in returned_form_values %}
                        <div class="alert {{ 'alert-success' if returned_form_values['remove_transfer'] else 'alert-danger' }} alert-dismissible fade show"
                             role="alert">
                            {{ 'Transfer removed successfully.' if returned_form_values['remove_transfer'] else 'An error occurred while removing the transfer.' }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endif %}

                    {# FORM #}
                    <div class="card mb-4">
                        <div class="card-header fw-semibold">
                            <i class="bi bi-plus-circle me-1"></i> Add a transfer
                        </div>
                        <div class="card-body">
                            <form method="post" action="#transfers" id="transferForm">
                                <input name="type" type="text" value="add_transfer" required readonly hidden/>

                                <div class="row g-3">
                                    {# Client #}
                                    <div class="col-md-5">
                                        <label class="form-label" for="user">Client</label>
                                        <select name="user" id="user" class="form-select" required>
                                            {% for user in users | sort(attribute='2') %}
                                                <option value="{{ user[0] }}">{{ user[2] }} {{ user[1] }} ({{ user[0] }})</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    {# Date #}
                                    <div class="col-md-4">
                                        <label class="form-label" for="date">
                                            Date (optional, defaults to current date)
                                        </label>
                                        <input name="date" id="date" type="date" class="form-control"/>
                                    </div>

                                    {# Credit #}
                                    <div class="col-md-3">
                                        <label class="form-label" for="credit">Credit</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-coin"></i></span>
                                            <input name="credit" id="credit" type="number" class="form-control"
                                                   placeholder="0.00" step=".01" required>
                                        </div>
                                    </div>

                                    {# Transfer type #}
                                    <div class="col-12">
                                        <label class="form-label d-block">Transfer type</label>
                                        <div class="btn-group" role="group" aria-label="Transfer type">
                                            <input type="radio" class="btn-check" name="transfer_type" id="typeBank"
                                                   value="bank" autocomplete="off" checked>
                                            <label class="btn btn-outline-primary" for="typeBank">
                                                <i class="bi bi-bank me-1"></i> Bank transfer
                                            </label>

                                            <input type="radio" class="btn-check" name="transfer_type" id="typeCash"
                                                   value="cash" autocomplete="off">
                                            <label class="btn btn-outline-primary" for="typeCash">
                                                <i class="bi bi-cash-stack me-1"></i> Cash transfer
                                            </label>

                                            <input type="radio" class="btn-check" name="transfer_type" id="typeSupply"
                                                   value="supply" autocomplete="off">
                                            <label class="btn btn-outline-primary" for="typeSupply">
                                                <i class="bi bi-cup-hot me-1"></i> Supplies reimbursement
                                            </label>
                                        </div>
                                    </div>

                                    {# Direction #}
                                    <div class="col-12">
                                        <label class="form-label d-block">Direction</label>
                                        <div class="btn-group" role="group" aria-label="Direction">
                                            <input type="radio" class="btn-check" name="direction" id="dirToClient"
                                                   value="u2is_to_client" autocomplete="off" checked>
                                            <label class="btn btn-outline-secondary" for="dirToClient">
                                                Client account increases
                                            </label>

                                            <input type="radio" class="btn-check" name="direction" id="dirToU2IS"
                                                   value="client_to_u2is" autocomplete="off">
                                            <label class="btn btn-outline-secondary" for="dirToU2IS">
                                                Client account decreases
                                            </label>
                                        </div>
                                        <div class="form-text d-none" id="directionHint">
                                            <i class="bi bi-lock-fill me-1"></i> Direction is fixed for supplies
                                            reimbursement.
                                        </div>
                                    </div>

                                    {# Submit #}
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-plus-lg me-1"></i> Add transfer
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <script>
                        const FORCED_DIRECTION = 'dirToClient';
                        const form = document.getElementById('transferForm');
                        const hint = document.getElementById('directionHint');
                        const dirRadios = form.querySelectorAll('input[name="direction"]');

                        function syncDirection() {
                            const isSupply = form.querySelector('input[name="transfer_type"]:checked').value === 'supply';
                            hint.classList.toggle('d-none', !isSupply);
                            dirRadios.forEach(r => {
                                if (isSupply) {
                                    r.checked = (r.id === FORCED_DIRECTION);
                                    r.disabled = (r.id !== FORCED_DIRECTION);   // the checked one is still submitted
                                } else {
                                    r.disabled = false;
                                }
                            });
                        }

                        form.querySelectorAll('input[name="transfer_type"]').forEach(r =>
                            r.addEventListener('change', syncDirection));
                        syncDirection();
                    </script>
                    {# Transfers #}
                    <div class="table-responsive">
                        <table id="transferList" class="table table-bordered table-hover table-sm align-middle">
                            <thead class="table-dark">
                            <tr>
                                <th>id</th>
                                <th>Name</th>
                                <th>Date</th>
                                <th>Credit</th>
                                <th>Type</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for transfer in transfers %}
                                <tr>
                                    <td class="text-muted small">{{ transfer[0] }}</td>
                                    <td>{{ transfer[1] }}</td>
                                    <td class="text-nowrap">{{ transfer[2] }}</td>
                                    <td class="fw-semibold {{ 'text-success' if transfer[3] > 0 else 'text-danger' }}">
                                        {{ transfer[3] }}
                                    </td>
                                    <td>{{ transfer[4] }}</td>
                                    <td>
                                        <form method="post">
                                            <input name="transfer" type="number" value="{{ transfer[0] }}" required
                                                   readonly hidden/>
                                            <input name="type" type="text" value="remove_transfer" required readonly
                                                   hidden/>
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# =================== EMAILS =================== #}
                <div class="tab-pane fade" id="emails">
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                        <h1 class="h2">Emails</h1>
                        <form method="get" action="" class="d-flex align-items-center gap-2" id="dateFilterForm">
                            <label class="form-label mb-0 text-nowrap" for="purchaseFrom">From</label>
                            <input type="date" id="purchaseFrom" name="from" class="form-control form-control-sm"
                                   value="{{ filter_from }}"/>
                            <label class="form-label mb-0 text-nowrap" for="purchaseTo">To</label>
                            <input type="date" id="purchaseTo" name="to" class="form-control form-control-sm"
                                   value="{{ filter_to }}"/>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-funnel"></i> Apply
                            </button>
                            <a href="?" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset
                            </a>
                        </form>
                    </div>

                    {# ERROR #}
                    {% if "resend_email" in returned_form_values %}
                        <div class="alert {{ 'alert-success' if returned_form_values['resend_email'] else 'alert-danger' }} alert-dismissible fade show"
                             role="alert">
                            {{ 'Email(s) scheduled for resending successfully. Refresh the page in a few minutes for it to show in the list.' if returned_form_values['send_email'] else 'An error occurred while scheduling the email(s) for resending.' }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endif %}
                    {% if "send_email" in returned_form_values %}
                        <div class="alert {{ 'alert-success' if returned_form_values['send_email'] else 'alert-danger' }} alert-dismissible fade show"
                             role="alert">
                            {{ 'Email(s) scheduled for sending successfully. Refresh the page in a few minutes for it to show in the list.' if returned_form_values['send_email'] else 'An error occurred while scheduling the email(s) for sending.' }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endif %}

                    {# FORM #}
                    <div class="d-flex flex-column gap-2 pb-2 mb-3">
                        <div class="d-flex flex-row gap-2 w-100" style="height: 400px">
                            <div class="d-flex flex-column gap-1" style="width: 20%">
                                <div class="d-flex flex-row gap-1 flex-wrap">
                                    <button class="btn btn-primary" onclick="selectEmails('all')">All</button>
                                    <button class="btn btn-primary" onclick="selectEmails('none')">None</button>
                                    <button class="btn btn-primary" onclick="selectEmails('active')">Active in the last
                                        6 months
                                    </button>
                                    <button class="btn btn-primary" onclick="selectEmails('withdebt')">With debt
                                    </button>
                                    <button class="btn btn-primary" onclick="selectEmails('nodebt')">No debt</button>
                                </div>
                                <div class="d-flex flex-column flex-nowrap input-group border border-1 rounded p-1
                border-dark overflow-y-scroll" id="emailReceiverSelection">
                                    {% for user in users | sort(attribute='2,1') %}
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value=""
                                                   id="checkUser{{ user[0] }}">
                                            <label class="form-check-label text-nowrap" for="checkUser{{ user[0] }}">
                                                {{ user[1] }} {{ user[2] }}
                                            </label>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1 w-100 h-100">
                                <p class="m-0 p-0">
                                    Write the content of the mail below. Know that for each user you can use the
                                    following macros: the firstname of the user [NAME], the surname of the user
                                    [SURNAME], the current balance of the user [USER_BALANCE], the date of departure of
                                    the user [DATE_OF_DEPARTURE], the configured contact email [ADMIN_EMAIL], the
                                    initial period [GRACE_PERIOD] where the alternative ceiling is used [GRACE_CEILING],
                                    the default debt ceiling [DEFAULT_CEILING], the configured available payment methods
                                    [PAYMENT_METHODS].
                                </p>
                                <input id="emailSubject" class="form-control w-100" placeholder="Subject" type="text">
                                <textarea id="emailContent" class="form-control w-100 h-100"></textarea>
                            </div>
                        </div>
                        <div class="ms-auto">
                            <button class="btn btn-primary" onclick="checkAndSubmit()">Send</button>
                        </div>
                        <script>
                            const users = {{ users | tojson }};

                            const KNOWN_MACROS = new Set([
                                'NAME', 'SURNAME', 'USER_BALANCE', 'DATE_OF_DEPARTURE',
                                'ADMIN_EMAIL', 'GRACE_PERIOD', 'GRACE_CEILING', 'DEFAULT_CEILING', 'PAYMENT_METHODS'
                            ]);

                            function selectEmails(type) {
                                const sixMonthsAgo = new Date();
                                sixMonthsAgo.setMonth(sixMonthsAgo.getMonth() - 6);

                                for (const user of users) {
                                    const id = user[0];
                                    const balance = user[17];
                                    // format: "2026-08-28 10:49:58"
                                    const lastCoffee = user[18] ? new Date(user[18].replace(' ', 'T')) : null;
                                    const checkbox = document.getElementById('checkUser' + id);
                                    if (!checkbox) continue;

                                    let checked = false;
                                    if (type === 'all') {
                                        checked = true;
                                    } else if (type === 'none') {
                                        checked = false;
                                    } else if (type === 'active') {
                                        checked = lastCoffee !== null && lastCoffee >= sixMonthsAgo;
                                    } else if (type === 'withdebt') {
                                        checked = balance > 0;
                                    } else if (type === 'nodebt') {
                                        checked = balance < 0;
                                    }
                                    checkbox.checked = checked;
                                }
                            }

                            function checkAndSubmit() {
                                const subject = document.getElementById('emailSubject').value.trim();
                                if (!subject) {
                                    alert('Please enter a subject.');
                                    return;
                                }
                                const content = document.getElementById('emailContent').value.trim();
                                if (!content) {
                                    alert('Please enter email content.');
                                    return;
                                }
                                // Validate that every [MACRO] in the body is a known one
                                const foundMacros = content.match(/\[[A-Z_]+\]/g) || [];
                                const unknownMacros = foundMacros.filter(m => !KNOWN_MACROS.has(m.slice(1, -1)));
                                if (unknownMacros.length > 0) {
                                    alert('Unknown macro(s) in content: ' + unknownMacros.join(', '));
                                    return;
                                }
                                // Collect checked user IDs
                                const selectedIds = users
                                    .map(u => u[0])
                                    .filter(id => document.getElementById('checkUser' + id)?.checked);
                                if (selectedIds.length === 0) {
                                    alert('Please select at least one recipient.');
                                    return;
                                }
                                const confirmed = confirm(
                                    `Send email to ${selectedIds.length} recipient${selectedIds.length !== 1 ? 's' : ''}?\n\nSubject: ${subject}`
                                );
                                if (!confirmed) return;
                                // Build and submit a hidden form, mirroring the resend pattern
                                const form = document.createElement('form');
                                form.method = 'post';
                                const addField = (name, value) => {
                                    const input = document.createElement('input');
                                    input.type = 'hidden';
                                    input.name = name;
                                    input.value = value;
                                    form.appendChild(input);
                                };
                                addField('type', 'send_email');
                                addField('subject', subject);
                                addField('content', content);
                                // One 'ids' field per recipient so the backend receives a list
                                for (const id of selectedIds) {
                                    addField('ids', id);
                                }
                                document.body.appendChild(form);
                                form.submit();
                            }
                        </script>
